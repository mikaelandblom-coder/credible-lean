{
  "permissions": {
    "allow": [
      "Bash(bash scripts/fetch_paper.sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && { bash \"$CLAUDE_PROJECT_DIR\"/scripts/session_branch.sh; bash \"$CLAUDE_PROJECT_DIR\"/scripts/fetch_mathlib.sh --background; python3 \"$CLAUDE_PROJECT_DIR\"/scripts/pending_status.py; } || true",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
